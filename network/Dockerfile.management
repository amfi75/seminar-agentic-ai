FROM ubuntu@sha256:68ee22004a9109b44973313b02ff7b1de250f1de0f5ecb628d73f579aaff33ac
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl openssh-client snmp iproute2 iputils-ping iperf3 python3 python3-venv procps libcap2-bin && rm -rf /var/lib/apt/lists/*
COPY network/versions.json network/install-tools.py /tmp/lab-tools/
RUN python3 /tmp/lab-tools/install-tools.py gnmic opencode && rm -rf /tmp/lab-tools
COPY network/python-requirements.txt /tmp/requirements.txt
RUN python3 -m venv /opt/clients && /opt/clients/bin/pip install --no-cache-dir -r /tmp/requirements.txt && rm /tmp/requirements.txt && groupadd -g 1004 lab-readers && useradd -m -u 1100 -s /bin/bash -G lab-readers agent && mkdir -p /home/agent/workspace && chown -R agent:agent /home/agent && find / -xdev -type f -perm /6000 -exec chmod a-s {} + && getcap -r / 2>/dev/null | cut -d' ' -f1 | xargs -r -n1 setcap -r
ENV PATH=/opt/clients/bin:/usr/local/bin:/usr/bin:/bin
ENV GNMIC_CONFIG=/home/agent/.lab/gnmic.yaml SNMPCONFPATH=/home/agent/.lab
WORKDIR /home/agent
USER agent
CMD ["sleep", "infinity"]
